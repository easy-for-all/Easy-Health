# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=sua_senha_segura

# Rails — copie o valor de api/config/master.key
RAILS_MASTER_KEY=
SECRET_KEY_BASE=

# CORS — origins permitidas (separadas por vírgula)
CORS_ORIGINS=https://easyhealth.art

# Fitness Intelligence — reservado para a futura troca do gerador de treino
USE_FITNESS_INTELLIGENCE_ENGINE=false

# Next.js
NEXT_PUBLIC_API_URL=https://api.easyhealth.art
# Play Store listing for the Android app promo (public). Optional — falls back to
# https://play.google.com/store/apps/details?id=com.EasyHealth.myapp
NEXT_PUBLIC_PLAY_STORE_URL=
# Google Ads conversion label for subscription success (public browser value)
NEXT_PUBLIC_GADS_SUBSCRIPTION_CONVERSION=
# Native Android Google Sign-In: the Web OAuth client ID (same value as
# GOOGLE_CLIENT_ID). Public, safe to expose. Used as serverClientId by the app.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase Analytics do app Android (o WebView carrega o bundle desta build).
# Chega ao bundle como BUILD ARG do serviço web (docker-compose.prod.yml), não
# como env de runtime: NEXT_PUBLIC_* é inlined no build, então mudar aqui exige
# REBUILD do frontend, não basta reiniciar o container.
# Deixe VAZIO/ausente para o default "true". Só "false" desliga (kill switch);
# qualquer outro valor falha o build de propósito.
NEXT_PUBLIC_FIREBASE_ANALYTICS_ENABLED=

# Sentry — monitoramento de erros
# Backend: obtenha em https://sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=
# Frontend (exposto ao browser): mesmo DSN do projeto Next.js ou projeto separado
NEXT_PUBLIC_SENTRY_DSN=

# Stripe — pagamentos recorrentes
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
FRONTEND_URL=https://easyhealth.art
API_URL=https://easyhealth.art/api

# Make.app — jornadas de relacionamento (outbound: EasyHealth → Make)
#
# FONTE DE VERDADE: config/communication_events.yml. Todo evento com entrada
# habilitada e ao menos um canal é um orchestration event e VAI para o Make.
# Kill switch global = MAKE_WEBHOOK_ENABLED=false; para desligar um evento
# específico, use `enabled: false` no YAML.
# Detalhes em docs/event-orchestration.md
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=
MAKE_WEBHOOK_ENABLED=false
MAKE_WEBHOOK_TIMEOUT_SECONDS=10
MAKE_WEBHOOK_PAYLOAD_MODE=minimal
# LEGADO. Já foi a allowlist; hoje só ADICIONA eventos sem entrada no YAML, para
# smoke test, e não funciona em produção sem o escape hatch abaixo. Um nome aqui
# nunca vira contrato de negócio: qualquer evento presente só aqui aparece como
# allowlist_drift no painel Eventos & Comunicações.
MAKE_WEBHOOK_ALLOWED_EVENTS=
MAKE_WEBHOOK_ALLOW_LEGACY_ENV_EVENTS=false
# O bloco push do payload (delivery.channels + push) exige schema v2.
MAKE_EVENT_SCHEMA_VERSION=2
MAKE_EVENT_CHANNEL_ROUTING_ENABLED=false

# Make.app — callback inbound (Make → EasyHealth)
# Segredo compartilhado enviado pelo Make no header X-Make-Secret
MAKE_INBOUND_WEBHOOK_SECRET=
# Bearer dedicado para callbacks de rastreabilidade de entrega interna no Make
# (POST /api/v1/integrations/make/event_delivery_callbacks).
MAKE_DELIVERY_CALLBACK_TOKEN=

# Make.app — orquestração de push (Make → EasyHealth, POST /api/v1/integrations/make/push_dispatches)
# Com a flag OFF o endpoint responde "orchestration_disabled" sem enviar nada.
MAKE_PUSH_ORCHESTRATION_ENABLED=false
# Bearer token dedicado do endpoint de dispatch (separado do webhook inbound).
# Para rotação sem downtime, defina _CURRENT/_PREVIOUS (ambos aceitos por um período curto).
MAKE_PUSH_DISPATCH_TOKEN=
MAKE_PUSH_DISPATCH_TOKEN_CURRENT=
MAKE_PUSH_DISPATCH_TOKEN_PREVIOUS=
# Limite coarse de dispatches por usuário por minuto (default 10).
MAKE_PUSH_RATE_LIMIT_PER_USER=10
# Etapa B da migração: e-mails autorizados a receber push real via Make (CSV).
MAKE_PUSH_ALLOWED_TEST_EMAILS=mail.marcus.reis@gmail.com

# Timezone operacional de comunicação. Timestamps persistidos seguem em UTC.
COMMUNICATION_DEFAULT_TIMEZONE=America/Sao_Paulo

# Quiet hours (22:00–07:00 no timezone do usuário) no DISPATCH de push.
# Não afeta a geração de evento — o fato nasce em qualquer horário.
# Com true, o endpoint persiste PushDispatch deferred e o backend libera depois.
PUSH_QUIET_HOURS_ENABLED=true
PUSH_QUIET_HOURS_START=22:00
PUSH_QUIET_HOURS_END=07:00

# Lembrete de treino agendado — emite scheduled_workout_reminder_due via Make
# antes do horário fixo do onboarding.
SCHEDULED_WORKOUT_REMINDER_ENABLED=true
# Antecedência do lembrete, em minutos (5–180). Central para poder testar
# 15/30/45 sem mexer em job, service ou payload.
SCHEDULED_WORKOUT_REMINDER_LEAD_MINUTES=30

# Firebase Cloud Messaging (FCM HTTP v1) — envio técnico de push (backend).
# Service account NUNCA vai para o Make. Use JSON puro OU a variante Base64.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
FIREBASE_PROJECT_ID=easyhealth-analytics

# Push de ativação — scheduler interno legado (Família B). DESATIVADO na V1: a
# jornada de push é orquestrada pelo Make (docs/push-journey-v1.md). Manter false.
ACTIVATION_PUSH_ENABLED=false
ACTIVATION_PUSH_EXPERIMENT_ENABLED=false

# Google AI — POC de geração de vídeo (scripts/generate_exercise_video.py)
# Obtenha em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Vertex AI (alternativa ao GOOGLE_API_KEY)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service_account.json
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# =============================================================================
# OBSERVABILIDADE — docs/observability/README.md
# =============================================================================
# Camada interna: contexto de requisição, logs JSON, heartbeats, checks,
# incidentes e painel /admin/observability. Nenhum coletor externo nesta etapa.

# Liga a camada inteira. Com false, nada é registrado (a aplicação segue igual).
OBSERVABILITY_ENABLED=true

# Logs JSON: sempre ligados em produção. Aqui só afeta dev/test.
OBSERVABILITY_JSON_LOGS=false

# Sal para hashear installation_id/session_id nos logs. Vazio = usa SECRET_KEY_BASE.
# Trocar este valor invalida a correlação histórica dos refs.
OBSERVABILITY_HASH_SALT=

# --- Alertas (DESLIGADOS por padrão) -----------------------------------------
# Ligue só depois de observar os thresholds por alguns dias em produção.
OBSERVABILITY_ALERTS_ENABLED=false
OBSERVABILITY_ALERT_WEBHOOK_URL=
OBSERVABILITY_ALERT_WEBHOOK_TOKEN=
# Minutos entre notificações do MESMO incidente. Escalada e resolução ignoram.
OBSERVABILITY_ALERT_COOLDOWN_MINUTES=60

# --- Retenção e amostras mínimas ---------------------------------------------
OBSERVABILITY_CHECK_RETENTION_DAYS=90
# Abaixo destes pisos o check devolve insufficient_data (nunca 0%).
OBSERVABILITY_MIN_ANDROID_SAMPLE=10
OBSERVABILITY_MIN_GOOGLE_AUTH_SAMPLE=10
OBSERVABILITY_MIN_HTTP_SAMPLE=20

# --- Thresholds: cadastro e vínculo Android ----------------------------------
ANDROID_REGISTRATION_WARNING_RATE=0.30
ANDROID_REGISTRATION_CRITICAL_RATE=0.15
ANDROID_LINK_WARNING_RATE=0.50
ANDROID_LINK_CRITICAL_RATE=0.30

# --- Thresholds: login Google ------------------------------------------------
GOOGLE_AUTH_WARNING_ERROR_RATE=0.10
GOOGLE_AUTH_CRITICAL_ERROR_RATE=0.25

# --- Réplica BI ---------------------------------------------------------------
# O horário REAL do cron vive na VPS (crontab -l), não neste repositório.
# scripts/bi_replica/install_cron.sh só fornece um padrão via CRON_SCHEDULE.
# Mantenha estes valores coerentes com o cron instalado, senão o check
# replica_refresh_stale alerta na hora errada.
BI_REPLICA_EXPECTED_HOUR=3
BI_REPLICA_GRACE_MINUTES=90

# --- Google Ads (painel Aquisição Android no Admin) ----------------------------
# Somente leitura: preenche o cache google_ads_daily_metrics consultado pelo Admin.
# Não altera campanha, orçamento nem lance. Credencial exclusiva backend -> Google
# Ads; NÃO tem relação com o Google Sign-In dos usuários (GOOGLE_CLIENT_ID).
# Descubra os três últimos IDs com: bin/rails google_ads:discover
# Doc: docs/google-ads-android-acquisition.md
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID_EASYHEALTH=
# Só quando a conta é gerenciada por um MCC. Vazio = header não é enviado.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_ANDROID_CAMPAIGN_ID=
GOOGLE_ADS_INSTALL_CONVERSION_ACTION_ID=
GOOGLE_ADS_SIGNUP_CONVERSION_ACTION_ID=
